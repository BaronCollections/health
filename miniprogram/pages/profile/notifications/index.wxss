.page-title {
  font-size: 40rpx;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin: 24rpx 28rpx 0;
}

.filter-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 2rpx solid rgba(217, 230, 215, 0.72);
  color: var(--mintbit-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.filter-chip--active {
  background: var(--mintbit-brand-soft);
  border-color: rgba(109, 181, 120, 0.45);
  color: var(--mintbit-brand-strong);
}

.notifications-stack,
.empty-card {
  margin-top: 24rpx;
}

.notification-card__top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.status-pill--unread {
  background: rgba(109, 181, 120, 0.2);
}

.notification-time {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--mintbit-text-secondary);
}
