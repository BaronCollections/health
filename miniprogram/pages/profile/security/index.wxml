<view class="page-shell">
  <mintbit-nav title="MintBit" subtitle="{{viewModel.header.title}}" showBack="{{true}}" backLabel="{{backLabel}}" />

  <view wx:if="{{viewModel}}" class="page-content">
    <view class="surface-card section-card">
      <view class="section-title page-title">{{viewModel.header.title}}</view>
      <view class="section-body">{{viewModel.header.subtitle}}</view>
    </view>

    <view class="surface-card section-card info-card">
      <view class="list-item__title">{{viewModel.binding.label}}</view>
      <view class="status-pill">{{viewModel.binding.statusLabel}}</view>
      <view class="spacer-20"></view>
      <view class="list-item__title">{{viewModel.ocrAuthorization.label}}</view>
      <view class="status-pill">{{viewModel.ocrAuthorization.statusLabel}}</view>
    </view>

    <view class="surface-card section-card info-card">
      <view class="list-item__title">{{viewModel.header.notificationLabel}}</view>
      <view class="list-stack prefs-stack">
        <view wx:for="{{viewModel.preferences}}" wx:key="id" class="list-item">
          <view class="list-item__content">
            <view class="list-item__title">{{item.label}}</view>
          </view>
          <view class="status-pill">{{item.enabledLabel}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
