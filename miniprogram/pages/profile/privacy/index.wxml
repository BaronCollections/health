<view class="page-shell">
  <mintbit-nav title="MintBit" subtitle="{{viewModel.header.title}}" showBack="{{true}}" backLabel="{{backLabel}}" />

  <view wx:if="{{viewModel}}" class="page-content">
    <view class="surface-card section-card">
      <view class="section-title page-title">{{viewModel.header.title}}</view>
      <view class="section-body">{{viewModel.header.subtitle}}</view>
    </view>

    <view class="surface-card section-card privacy-card">
      <view class="list-item__title">{{viewModel.header.notificationPrefsLabel}}</view>
      <view class="list-stack prefs-stack">
        <view wx:for="{{viewModel.notificationPreferences}}" wx:key="id" class="list-item">
          <view class="list-item__content">
            <view class="list-item__title">{{item.label}}</view>
          </view>
          <view class="status-pill">{{item.enabledLabel}}</view>
        </view>
      </view>
    </view>

    <view class="surface-card section-card privacy-card">
      <view class="list-item__title">{{viewModel.header.exportCta}}</view>
      <view class="list-item__body">{{viewModel.exportRequest.scopeSummary}}</view>
      <view class="status-pill">{{viewModel.exportRequest.statusLabel}}</view>
      <view class="button-row">
        <view class="button-primary" bindtap="handleOpenExport">{{viewModel.header.exportCta}}</view>
      </view>
    </view>

    <view class="surface-card section-card privacy-card">
      <view class="list-item__title">{{viewModel.header.deleteCta}}</view>
      <view class="list-item__body">{{viewModel.deleteRequest.impactSummary}}</view>
      <view class="status-pill">{{viewModel.deleteRequest.statusLabel}}</view>
      <view class="button-row">
        <view class="button-secondary" bindtap="handleOpenDelete">{{viewModel.header.deleteCta}}</view>
      </view>
    </view>

    <view class="list-stack document-stack">
      <view wx:for="{{viewModel.documents}}" wx:key="title" wx:for-item="document" class="surface-card section-card document-card">
        <view class="list-item__title">{{document.title}}</view>
        <view wx:for="{{document.body}}" wx:key="*this" wx:for-item="line" class="list-item__body">{{line}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{viewModel}}" class="page-actions">
    <view class="button-secondary button-wide" bindtap="handleOpenSecurity">{{viewModel.header.securityCta}}</view>
    <view class="button-ghost button-wide" bindtap="handleOpenAudit">{{viewModel.header.auditCta}}</view>
  </view>
</view>
