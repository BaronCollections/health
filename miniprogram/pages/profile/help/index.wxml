<view class="page-shell">
  <mintbit-nav title="MintBit" subtitle="{{viewModel.header.eyebrow}}" showBack="{{true}}" backLabel="{{backLabel}}" />

  <view wx:if="{{viewModel}}" class="page-content">
    <view class="surface-card section-card">
      <view class="section-title page-title">{{viewModel.header.title}}</view>
      <view class="section-body">{{viewModel.header.subtitle}}</view>
      <view class="button-row">
        <view class="button-primary" bindtap="handleOpenFeedback">{{viewModel.header.feedbackCta}}</view>
        <view class="button-secondary" bindtap="handleOpenRecords">{{viewModel.header.feedbackRecordsCta}}</view>
      </view>
    </view>

    <view class="surface-card section-card support-card">
      <view class="list-item__title">{{viewModel.header.supportLabel}}</view>
      <view class="list-item__body">{{viewModel.header.supportValue}}</view>
    </view>

    <view class="list-stack faq-stack">
      <view wx:for="{{viewModel.faqCategories}}" wx:key="id" wx:for-item="category" class="surface-card section-card faq-card">
        <view class="list-item__title">{{category.title}}</view>
        <view wx:for="{{category.items}}" wx:key="question" wx:for-item="faq" class="faq-item">
          <view class="faq-question">{{faq.question}}</view>
          <view class="faq-answer">{{faq.answer}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
