.page-title {
  font-size: 40rpx;
}

.form-card {
  margin-top: 24rpx;
}

.form-label {
  margin-top: 26rpx;
}

.tag-grid {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.tag-choice {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid rgba(217, 230, 215, 0.9);
  color: var(--mintbit-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.tag-choice--active {
  background: var(--mintbit-brand-soft);
  border-color: rgba(109, 181, 120, 0.45);
  color: var(--mintbit-brand-strong);
}

.form-textarea {
  min-height: 220rpx;
  padding: 24rpx 26rpx;
}

.error-text {
  margin-top: 24rpx;
  color: #c76655;
  font-size: 24rpx;
}

.page-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 245, 239, 0) 0%, rgba(247, 245, 239, 0.98) 38%);
  box-sizing: border-box;
}

.button-wide {
  width: 100%;
}
