.page-title {
  font-size: 40rpx;
}

.records-stack,
.empty-card {
  margin-top: 24rpx;
}

.record-item + .record-item {
  margin-top: 24rpx;
}

.record-item__subject {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mintbit-text);
}

.record-item__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--mintbit-text-secondary);
}

.record-attachment {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
}

.record-attachment__label {
  font-size: 22rpx;
  color: var(--mintbit-brand-strong);
  word-break: break-all;
}

.record-attachment__cta {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--mintbit-brand-strong);
}

.record-reply {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(109, 181, 120, 0.08);
  font-size: 24rpx;
  color: var(--mintbit-brand-strong);
}
