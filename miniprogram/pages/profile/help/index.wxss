.page-title {
  font-size: 40rpx;
}

.support-card,
.faq-stack {
  margin-top: 24rpx;
}

.faq-item + .faq-item {
  margin-top: 24rpx;
}

.faq-question {
  margin-top: 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mintbit-text);
}

.faq-answer {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--mintbit-text-secondary);
}
