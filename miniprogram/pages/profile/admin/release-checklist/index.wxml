<view class="page-shell">
  <mintbit-nav title="MintBit" subtitle="{{checklist.title}}" showBack="{{true}}" backLabel="{{backLabel}}" />

  <view wx:if="{{checklist}}" class="page-content">
    <view class="surface-card section-card">
      <view class="section-title page-title">{{checklist.title}}</view>
      <view class="section-body">{{checklist.subtitle}}</view>
    </view>

    <view class="list-stack checklist-stack">
      <view wx:for="{{checklist.items}}" wx:key="id" class="surface-card section-card">
        <view class="list-item__title">{{item.title}}</view>
        <view class="list-item__body">{{item.value}}</view>
      </view>
    </view>
  </view>
</view>
