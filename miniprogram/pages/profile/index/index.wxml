<view class="page-shell">
  <mintbit-nav title="MintBit" />

  <view wx:if="{{copy}}" class="page-content">
    <view class="surface-card section-card">
      <view class="section-title">{{copy.title}}</view>
      <view class="section-body">{{copy.subtitle}}</view>
      <view class="spacer-20"></view>
      <locale-switch locale="{{locale}}" label="{{switchLanguageLabel}}" bind:change="handleLocaleChange" />
    </view>

    <view class="surface-card section-card" style="margin-top: 24rpx;">
      <view class="status-pill">{{authStatus}}</view>
      <view class="section-title" style="font-size: 38rpx; margin-top: 20rpx;">{{copy.guestTitle}}</view>
      <view class="section-body">{{copy.guestBody}}</view>
      <view class="button-row">
        <view class="button-primary" bindtap="handleAuthCta">{{copy.authCta}}</view>
      </view>
    </view>

    <view class="list-stack" style="margin-top: 24rpx;">
      <view
        wx:for="{{copy.cards}}"
        wx:key="id"
        class="list-item surface-card"
        data-href="{{item.href}}"
        bindtap="handleCardTap"
      >
        <view class="list-item__content">
          <view class="list-item__title">{{item.title}}</view>
          <view class="list-item__body">{{item.body}}</view>
        </view>
        <view class="list-item__arrow">›</view>
      </view>
    </view>
  </view>
</view>
