<view class="page-shell">
  <mintbit-nav title="{{brandName}}" subtitle="{{viewModel.title}}" />

  <view wx:if="{{viewModel}}" class="page-content">
    <view class="surface-card section-card">
      <view class="eyebrow">{{viewModel.goalLabel || viewModel.title}}</view>
      <view class="section-title">{{viewModel.title}}</view>
      <view class="section-body">{{viewModel.subtitle}}</view>
      <view class="button-row">
        <view class="button-primary button-wide" bindtap="handleCheckIn">{{viewModel.primaryActionLabel}}</view>
      </view>
    </view>

    <view class="spacer-20"></view>

    <view class="summary-grid">
      <view class="mini-card summary-card">
        <view class="summary-label">{{viewModel.summary.streakLabel}}</view>
        <view class="summary-value">{{viewModel.summary.streakValue}}</view>
      </view>
      <view class="mini-card summary-card">
        <view class="summary-label">{{viewModel.summary.monthlyLabel}}</view>
        <view class="summary-value">{{viewModel.summary.monthlyValue}}</view>
      </view>
      <view class="mini-card summary-card">
        <view class="summary-label">{{viewModel.summary.totalLabel}}</view>
        <view class="summary-value">{{viewModel.summary.totalValue}}</view>
      </view>
      <view class="mini-card summary-card">
        <view class="summary-label">{{viewModel.summary.pointsLabel}}</view>
        <view class="summary-value">{{viewModel.summary.pointsValue}}</view>
      </view>
    </view>

    <view class="spacer-20"></view>

    <view class="surface-card section-card">
      <view class="section-header">{{viewModel.microGoalTitle}}</view>
      <view class="section-body">{{viewModel.timelineHint}}</view>
    </view>

    <view class="spacer-20"></view>

    <view class="surface-card section-card">
      <view class="section-header">{{viewModel.planTitle}}</view>

      <view wx:if="{{!viewModel.planCards.length}}" class="mini-card">
        <view class="mini-card__title">{{viewModel.emptyState.title}}</view>
        <view class="mini-card__body">{{viewModel.emptyState.body}}</view>
      </view>

      <view wx:if="{{viewModel.planCards.length}}" class="list-stack">
        <view wx:for="{{viewModel.planCards}}" wx:key="id" class="mini-card plan-card">
          <view class="plan-tag">{{item.category}}</view>
          <view class="mini-card__title">{{item.name}}</view>
          <view class="mini-card__body">{{item.benefit}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{viewModel}}" class="page-actions">
    <view class="button-secondary button-wide" bindtap="handleOpenReport">{{viewModel.secondaryActions.report}}</view>
    <view class="button-ghost button-wide" bindtap="handleOpenCommunity">{{viewModel.secondaryActions.community}}</view>
  </view>
</view>
