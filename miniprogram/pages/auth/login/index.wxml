<view class="page-shell">
  <mintbit-nav title="MintBit" showBack="{{true}}" backLabel="Back" />

  <view wx:if="{{copy}}" class="page-content">
    <view class="surface-card section-card">
      <view class="section-title">{{copy.loginTitle}}</view>
      <view class="section-body">{{copy.loginBody}}</view>
      <view wx:if="{{errorMessage}}" class="section-body" style="color: #b4503c;">{{errorMessage}}</view>
      <view class="button-row">
        <view class="button-primary" bindtap="handleContinue">{{isSubmitting ? '...' : copy.loginCta}}</view>
      </view>
    </view>

    <view style="margin-top: 24rpx;">
      <fallback-state tone="info" title="WeChat auth" body="The page now uses wx.login and the backend mini program auth contract. If the account is not bound yet, it continues into phone binding." />
    </view>
  </view>
</view>
