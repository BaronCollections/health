<view class="page-shell">
  <mintbit-nav title="MintBit" showBack="{{true}}" backLabel="Back" />

  <view wx:if="{{copy}}" class="page-content">
    <view class="surface-card section-card">
      <view class="section-title">{{copy.loginTitle}}</view>
      <view class="section-body">{{copy.loginBody}}</view>
      <view class="button-row">
        <view class="button-primary" bindtap="handleContinue">{{copy.loginCta}}</view>
      </view>
    </view>

    <view style="margin-top: 24rpx;">
      <fallback-state tone="info" title="Mock login" body="This foundation step keeps WeChat login in a safe local placeholder until API adapters are wired." />
    </view>
  </view>
</view>
