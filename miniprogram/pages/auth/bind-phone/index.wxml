<view class="page-shell">
  <mintbit-nav title="MintBit" showBack="{{true}}" backLabel="Back" />

  <view wx:if="{{copy}}" class="page-content">
    <view class="surface-card section-card">
      <view class="section-title">{{copy.bindTitle}}</view>
      <view class="section-body">{{copy.bindBody}}</view>

      <view class="form-stack">
        <view>
          <text class="field-label">{{copy.bindPhoneLabel}}</text>
          <input class="text-input" type="number" placeholder="{{copy.bindPhoneLabel}}" value="{{phone}}" bindinput="handlePhoneInput" />
        </view>
        <view>
          <text class="field-label">{{copy.bindCodeLabel}}</text>
          <input class="text-input" type="number" placeholder="{{copy.bindCodeLabel}}" value="{{code}}" bindinput="handleCodeInput" />
        </view>
      </view>

      <view class="button-row">
        <view class="button-secondary" bindtap="handleSendCode">{{copy.bindSendCode}}</view>
        <view class="button-primary" bindtap="handleSubmit">{{copy.bindSubmit}}</view>
      </view>
    </view>
  </view>
</view>
