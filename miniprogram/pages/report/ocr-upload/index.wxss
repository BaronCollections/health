.upload-formats {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--mintbit-text-secondary);
}

.upload-card-title {
  font-size: 40rpx;
}

.button-wide {
  width: 100%;
}

.status-note {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 243, 220, 0.9);
  color: #9a6500;
  font-size: 24rpx;
  line-height: 1.6;
}

.file-meta-card {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(244, 250, 245, 0.95);
}

.file-meta-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.file-meta-row + .file-meta-row {
  margin-top: 18rpx;
}

.file-meta-label {
  font-size: 24rpx;
  color: var(--mintbit-text-secondary);
}

.file-meta-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mintbit-text);
  word-break: break-all;
}

.process-stack {
  margin-top: 28rpx;
}

.process-item {
  background: rgba(250, 252, 249, 0.96);
}

.process-body {
  margin-top: 0;
  color: var(--mintbit-text);
}

.upload-footer {
  margin: 28rpx 8rpx 0;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--mintbit-text-secondary);
}
