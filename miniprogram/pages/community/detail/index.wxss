.post-head {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.avatar-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(109, 181, 120, 0.18);
  color: var(--mintbit-brand-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.post-head__meta {
  flex: 1;
}

.post-head__author {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mintbit-text);
}

.post-head__role,
.post-head__time,
.comment-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mintbit-text-secondary);
}

.post-content {
  margin-top: 24rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--mintbit-text);
}

.moderation-note {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(109, 181, 120, 0.08);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--mintbit-brand-strong);
}

.tag-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tag-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--mintbit-brand-soft);
  color: var(--mintbit-brand-strong);
  font-size: 22rpx;
  font-weight: 600;
}

.image-strip {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
  overflow-x: auto;
}

.image-strip__item {
  width: 210rpx;
  height: 210rpx;
  border-radius: 24rpx;
  background: rgba(221, 232, 223, 0.72);
  flex-shrink: 0;
}

.comments-card {
  margin-top: 24rpx;
}

.comments-list {
  margin-top: 24rpx;
}

.comments-empty {
  margin-top: 22rpx;
}

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.comment-head__author {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mintbit-text);
}

.comment-label {
  margin-top: 28rpx;
}

.comment-textarea {
  min-height: 220rpx;
  padding: 24rpx 26rpx;
}

.button-wide {
  width: 100%;
}
