<view class="page-shell">
  <mintbit-nav
    title="{{brandName}}"
    subtitle="{{viewModel.header.title}}"
    showBack="{{true}}"
    backLabel="{{backLabel}}"
  />

  <view wx:if="{{viewModel}}" class="page-content">
    <view class="surface-card section-card">
      <view class="section-title create-title">{{viewModel.header.title}}</view>
      <view class="section-body">{{viewModel.header.subtitle}}</view>
    </view>

    <view class="surface-card section-card form-card">
      <view class="field-label">{{viewModel.fields.circleLabel}}</view>
      <view class="circle-grid">
        <view
          wx:for="{{viewModel.circles}}"
          wx:key="id"
          class="circle-choice {{item.selected ? 'circle-choice--active' : ''}}"
          data-circle-id="{{item.id}}"
          bindtap="handleCircleSelect"
        >
          <view class="circle-choice__title">{{item.name}}</view>
          <view class="circle-choice__body">{{item.description}}</view>
        </view>
      </view>

      <view class="field-label content-label">{{viewModel.fields.contentLabel}}</view>
      <textarea
        class="text-input composer-textarea"
        placeholder="{{viewModel.fields.contentPlaceholder}}"
        value="{{contentValue}}"
        maxlength="400"
        bindinput="handleContentInput"
      />

      <view class="field-label content-label">{{viewModel.fields.tagsLabel}}</view>
      <view class="tag-grid">
        <view
          wx:for="{{viewModel.tagOptions}}"
          wx:key="id"
          class="tag-choice {{item.selected ? 'tag-choice--active' : ''}}"
          data-tag="{{item.id}}"
          bindtap="handleTagToggle"
        >
          {{item.label}}
        </view>
      </view>

      <view class="hint-card">
        <view class="mini-card__title">{{viewModel.tips.imageHint}}</view>
        <view class="mini-card__body">{{viewModel.tips.pendingHint}}</view>
      </view>

      <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
    </view>
  </view>

  <view wx:if="{{viewModel}}" class="page-actions">
    <view class="button-primary button-wide" bindtap="handleSubmit">{{viewModel.actions.submit}}</view>
  </view>
</view>
