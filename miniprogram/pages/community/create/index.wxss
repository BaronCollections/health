.create-title {
  font-size: 40rpx;
}

.form-card {
  margin-top: 24rpx;
}

.circle-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.circle-choice {
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(244, 250, 245, 0.92);
  border: 2rpx solid transparent;
}

.circle-choice--active {
  border-color: rgba(109, 181, 120, 0.45);
  background: rgba(109, 181, 120, 0.1);
}

.circle-choice__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mintbit-text);
}

.circle-choice__body {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--mintbit-text-secondary);
}

.content-label {
  margin-top: 28rpx;
}

.composer-textarea {
  min-height: 260rpx;
  padding: 24rpx 26rpx;
}

.tag-grid {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag-choice {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid rgba(217, 230, 215, 0.9);
  color: var(--mintbit-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.tag-choice--active {
  background: var(--mintbit-brand-soft);
  border-color: rgba(109, 181, 120, 0.45);
  color: var(--mintbit-brand-strong);
}

.attachment-actions {
  margin-top: 16rpx;
}

.attachment-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.attachment-card {
  padding: 16rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(217, 230, 215, 0.88);
}

.attachment-card__image {
  width: 100%;
  height: 220rpx;
  border-radius: 22rpx;
  background: rgba(221, 232, 223, 0.72);
}

.attachment-card__name {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--mintbit-text);
  line-height: 1.5;
  word-break: break-all;
}

.attachment-card__remove {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #c76655;
}

.attachment-empty {
  margin-top: 18rpx;
}

.hint-card {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(244, 250, 245, 0.92);
}

.error-text {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #c76655;
}

.page-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 245, 239, 0) 0%, rgba(247, 245, 239, 0.98) 38%);
  box-sizing: border-box;
}

.button-wide {
  width: 100%;
}
