.review-hero {
  margin-top: 12rpx;
}

.review-title {
  font-size: 40rpx;
}

.tab-row {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
}

.community-tab {
  min-width: 168rpx;
  padding: 18rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid rgba(217, 230, 215, 0.72);
  box-sizing: border-box;
}

.community-tab--active {
  background: rgba(109, 181, 120, 0.12);
  border-color: rgba(109, 181, 120, 0.4);
}

.community-tab__label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--mintbit-text);
}

.community-tab__count {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--mintbit-brand-strong);
}

.empty-card,
.review-stack {
  margin-top: 24rpx;
}

.review-card__header {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.avatar-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(109, 181, 120, 0.18);
  color: var(--mintbit-brand-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.review-card__meta {
  flex: 1;
}

.review-card__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.post-card__author {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mintbit-text);
}

.post-card__time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--mintbit-text-secondary);
}

.review-card__content {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--mintbit-text);
}

.review-note {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #fff6e8;
  color: #8c5a13;
  font-size: 24rpx;
  line-height: 1.7;
}

.review-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.review-action {
  margin: 0;
  padding: 0 24rpx;
  min-height: 84rpx;
  border-radius: 999rpx;
  background: rgba(109, 181, 120, 0.12);
  color: var(--mintbit-brand-strong);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  line-height: 1;
}

.review-action::after {
  border: 0;
}

.review-action--disabled {
  opacity: 0.48;
}
