<view class="page-shell">
  <mintbit-nav
    title="{{brandName}}"
    subtitle="{{viewModel.header.title}}"
    showBack="{{true}}"
    backLabel="{{backLabel}}"
  />

  <view wx:if="{{viewModel}}" class="page-content">
    <view class="surface-card section-card">
      <view class="section-title my-posts-title">{{viewModel.header.title}}</view>
      <view class="section-body">{{viewModel.header.subtitle}}</view>
      <view class="button-row">
        <view class="button-primary" bindtap="handleOpenCreate">{{viewModel.resubmitLabel}}</view>
      </view>
    </view>

    <view class="tab-grid">
      <view
        wx:for="{{viewModel.tabs}}"
        wx:key="id"
        class="status-tab {{item.active ? 'status-tab--active' : ''}}"
        data-status="{{item.id}}"
        bindtap="handleTabChange"
      >
        <view class="status-tab__label">{{item.label}}</view>
        <view class="status-tab__count">{{item.count}}</view>
      </view>
    </view>

    <view wx:if="{{!viewModel.posts.length}}" class="surface-card section-card empty-card">
      <view class="list-item__title">{{viewModel.emptyState.title}}</view>
      <view class="list-item__body">{{viewModel.emptyState.body}}</view>
    </view>

    <view wx:if="{{viewModel.posts.length}}" class="list-stack posts-stack">
      <view
        wx:for="{{viewModel.posts}}"
        wx:key="id"
        wx:for-item="post"
        class="surface-card section-card post-card"
        data-post-id="{{post.id}}"
        bindtap="handleOpenPost"
      >
        <view class="post-card__top">
          <view class="status-pill">{{post.statusLabel}}</view>
          <view class="post-card__time">{{post.relativeTime}}</view>
        </view>
        <view class="post-card__content">{{post.content}}</view>
        <view wx:if="{{post.moderationReason}}" class="moderation-note">{{post.moderationReason}}</view>
        <view wx:if="{{post.images.length}}" class="image-strip">
          <image
            wx:for="{{post.images}}"
            wx:key="id"
            wx:for-item="image"
            class="image-strip__item"
            src="{{image.tempFilePath}}"
            mode="aspectFill"
            data-post-id="{{post.id}}"
            data-image-path="{{image.tempFilePath}}"
            catchtap="handlePreviewPostImages"
          />
        </view>
        <view class="post-card__footer">{{post.circleName}} · {{post.likes}} / {{post.saves}}</view>
      </view>
    </view>
  </view>
</view>
