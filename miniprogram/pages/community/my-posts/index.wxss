.my-posts-title {
  font-size: 40rpx;
}

.tab-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin: 24rpx 28rpx 0;
}

.status-tab {
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(217, 230, 215, 0.72);
}

.status-tab--active {
  border-color: rgba(109, 181, 120, 0.48);
  background: rgba(109, 181, 120, 0.1);
}

.status-tab__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mintbit-text);
}

.status-tab__count {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--mintbit-brand-strong);
}

.posts-stack,
.empty-card {
  margin-top: 24rpx;
}

.post-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.post-card__time,
.post-card__footer {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--mintbit-text-secondary);
}

.post-card__content {
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--mintbit-text);
}

.moderation-note {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(109, 181, 120, 0.08);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--mintbit-brand-strong);
}

.image-strip {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  overflow-x: auto;
}

.image-strip__item {
  width: 180rpx;
  height: 180rpx;
  border-radius: 22rpx;
  background: rgba(221, 232, 223, 0.72);
  flex-shrink: 0;
}
