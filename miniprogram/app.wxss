page {
  --mintbit-brand: #6db578;
  --mintbit-brand-strong: #4f9a5c;
  --mintbit-brand-soft: #eff8f0;
  --mintbit-text: #1d3422;
  --mintbit-text-secondary: #617064;
  --mintbit-border: #d9e6d7;
  --mintbit-page: #f7f5ef;
  --mintbit-card: rgba(255, 255, 255, 0.94);
  --mintbit-shadow: 0 24rpx 80rpx rgba(83, 125, 90, 0.12);
  min-height: 100%;
  background:
    radial-gradient(circle at top right, rgba(109, 181, 120, 0.22), transparent 34%),
    linear-gradient(180deg, #f4faef 0%, #f7f5ef 42%, #fffdf7 100%);
  color: var(--mintbit-text);
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-content {
  padding: 32rpx 28rpx 0;
}

.surface-card {
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 36rpx;
  background: var(--mintbit-card);
  box-shadow: var(--mintbit-shadow);
  backdrop-filter: blur(18rpx);
}

.section-card {
  padding: 32rpx;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--mintbit-brand-soft);
  color: var(--mintbit-brand-strong);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.section-title {
  margin-top: 24rpx;
  font-size: 56rpx;
  line-height: 1.2;
  font-weight: 600;
  color: var(--mintbit-text);
}

.section-body {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--mintbit-text-secondary);
}

.button-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  flex-wrap: wrap;
}

.button-primary,
.button-secondary,
.button-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.button-primary {
  background: linear-gradient(135deg, var(--mintbit-brand) 0%, #8ec68d 100%);
  color: #ffffff;
}

.button-secondary {
  border: 2rpx solid var(--mintbit-border);
  background: rgba(255, 255, 255, 0.9);
  color: var(--mintbit-text);
}

.button-ghost {
  background: var(--mintbit-brand-soft);
  color: var(--mintbit-brand-strong);
}

.card-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}

.mini-card {
  border-radius: 28rpx;
  padding: 28rpx;
  background: rgba(244, 250, 245, 0.92);
}

.mini-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mintbit-text);
}

.mini-card__body {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--mintbit-text-secondary);
}

.list-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
}

.list-item__content {
  flex: 1;
}

.list-item__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mintbit-text);
}

.list-item__body {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--mintbit-text-secondary);
}

.list-item__arrow {
  font-size: 34rpx;
  color: var(--mintbit-brand-strong);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(109, 181, 120, 0.12);
  color: var(--mintbit-brand-strong);
  font-size: 22rpx;
  font-weight: 600;
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--mintbit-text-secondary);
}

.text-input {
  width: 100%;
  min-height: 92rpx;
  padding: 0 26rpx;
  border: 2rpx solid rgba(217, 230, 215, 0.9);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  color: var(--mintbit-text);
  font-size: 28rpx;
  box-sizing: border-box;
}

.spacer-20 {
  height: 20rpx;
}
